# Required: create a Gemini API key and set it in your hosting provider's secret settings.
GEMINI_API_KEY=replace_with_your_own_key
# Set this to a model currently enabled for your Gemini API account.
GEMINI_MODEL=gemini-2.5-flash
# Optional: verified USD prices per 1 million tokens for this exact model.
GEMINI_INPUT_PRICE_PER_1M=
GEMINI_OUTPUT_PRICE_PER_1M=
# Persistent storage path (Render blueprint sets this automatically).
STUDENTFLOW_DATA_DIR=
